#!/usr/bin/env bash
# fi — run Z-Image Turbo (int8) locally.
#
#   fi "a red fox in fresh snow"          make one image → outputs/
#   fi "..." --size 768x1344 --seed 7     portrait, fixed seed
#   fi serve                              web UI on :7861 (engine stays on 127.0.0.1)
#   fi bench                              measure seconds per image on this machine
#   fi doctor                             show what was detected and which flags are used
#
# Options for single images:
#   --size WxH     default 1024x1024 (multiples of 64)
#   --steps N      default 8, 6 on Macs with ≤18 GB (6 is faster with a little less detail)
#   --seed N       default random
#   -o FILE        output path (default outputs/<time>.png)
set -euo pipefail

# Cloud shells and nohup fully buffer stdout, so ./fi serve looks frozen.
# Re-exec once under line buffering (Linux stdbuf). Status also goes to stderr.
if [ -z "${FI_UNBUFFERED:-}" ] && command -v stdbuf >/dev/null 2>&1; then
  export FI_UNBUFFERED=1 PYTHONUNBUFFERED=1
  exec stdbuf -oL -eL "$0" "$@"
fi
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
# shellcheck source=scripts/common.sh
source "$ROOT/scripts/common.sh"

SD_PORT="${FI_SD_PORT:-7860}"
UI_PORT="${FI_UI_PORT:-7861}"

usage() { sed -n '2,15p' "$ROOT/fi" | sed 's/^# \{0,1\}//'; }

# curl that fails fast when nothing is listening (default curl can hang for minutes).
sd_up() { curl -sf --connect-timeout 1 --max-time 2 "http://127.0.0.1:$SD_PORT/sdapi/v1/sd-models" >/dev/null 2>&1; }

start_engine() {
  engine_args
  if sd_up; then
    ok "engine already running on 127.0.0.1:$SD_PORT"
    return
  fi
  info "loading the model (often 1–3 min on first start)…"
  info "engine log follows — full file: $FI_HOME/server.log"
  : >"$FI_HOME/server.log"
  # sd-server block-buffers logs when stdout is a file; stdbuf makes them line-buffered.
  if command -v stdbuf >/dev/null 2>&1; then
    stdbuf -oL -eL "$FI_HOME/bin/sd-server" --listen-ip 127.0.0.1 --listen-port "$SD_PORT" "${FI_ARGS[@]}" --steps "$FI_STEPS" \
      >>"$FI_HOME/server.log" 2>&1 &
  else
    "$FI_HOME/bin/sd-server" --listen-ip 127.0.0.1 --listen-port "$SD_PORT" "${FI_ARGS[@]}" --steps "$FI_STEPS" \
      >>"$FI_HOME/server.log" 2>&1 &
  fi
  SD_PID=$!
  # Mirror new log lines to this terminal so a cloud shell is not a blank wait.
  tail -n 0 -F "$FI_HOME/server.log" 2>/dev/null &
  TAIL_PID=$!
  trap 'kill $SD_PID $TAIL_PID ${UI_PID:-} 2>/dev/null || true' EXIT
  trap 'exit 130' INT TERM
  local i=0
  until sd_up; do
    if ! kill -0 "$SD_PID" 2>/dev/null; then
      kill "$TAIL_PID" 2>/dev/null || true
      echo
      tail -30 "$FI_HOME/server.log" || true
      die "engine stopped. Log: $FI_HOME/server.log"
    fi
    i=$((i + 1))
    if [ "$i" -gt 600 ]; then
      kill "$TAIL_PID" 2>/dev/null || true
      echo
      die "engine did not start in 5 minutes. Log: $FI_HOME/server.log"
    fi
    # Heartbeat even when the engine has not printed yet (CUDA init can be silent).
    if [ $((i % 10)) -eq 0 ]; then
      printf '  … still loading (%ss)\n' "$((i / 2))"
    fi
    sleep 0.5
  done
  kill "$TAIL_PID" 2>/dev/null || true
  wait "$TAIL_PID" 2>/dev/null || true
  printf '\n'
}

cmd_generate() {
  local prompt="" size=1024x1024 steps="" seed=-1 out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) size="$2"; shift 2 ;;
      --steps) steps="$2"; shift 2 ;;
      --seed) seed="$2"; shift 2 ;;
      -o|--out) out="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) prompt="${prompt:+$prompt }$1"; shift ;;
    esac
  done
  [ -n "$prompt" ] || { usage; exit 1; }
  require_install
  engine_args
  steps="${steps:-$FI_STEPS}"
  local w="${size%x*}" h="${size#*x}"
  mkdir -p "$ROOT/outputs"
  out="${out:-$ROOT/outputs/$(date +%Y%m%d-%H%M%S).png}"
  info "$FI_DEVICE · ${w}×${h} · $steps steps"
  local t0=$SECONDS
  "$FI_HOME/bin/sd-cli" "${FI_ARGS[@]}" -p "$prompt" -W "$w" -H "$h" --steps "$steps" -s "$seed" -o "$out" \
    >"$FI_HOME/last.log" 2>&1 || { tail -20 "$FI_HOME/last.log"; die "generation failed. Log: $FI_HOME/last.log"; }
  ok "$out  ($((SECONDS - t0)) s incl. model load — use 'fi serve' to keep it loaded)"
}

port_listening() {
  (echo >/dev/tcp/127.0.0.1/"$1") >/dev/null 2>&1
}

# Vast maps only the ports requested at instance start. 7861 is often closed
# while 10100/10200/etc. are already public — use one of those if it is free.
vast_bind_ui_port() {
  [ -n "${PUBLIC_IPADDR:-}${VAST_CONTAINERLABEL:-}" ] || return 0
  local ext line in_port
  ext="$(printenv "VAST_TCP_PORT_${UI_PORT}" 2>/dev/null || true)"
  if [ -n "$ext" ] && ! port_listening "$UI_PORT"; then return 0; fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    in_port="${line#VAST_TCP_PORT_}"; in_port="${in_port%%=*}"
    # 22 ssh, 1111 instance portal, 8080 jupyter, 6006 tensorboard, 8384 sync.
    case "$in_port" in 22|1111|8080|6006|8384) continue ;; esac
    port_listening "$in_port" && continue
    [ "$in_port" = "$UI_PORT" ] || info "using Vast published port $in_port (internal) instead of $UI_PORT"
    UI_PORT=$in_port
    return 0
  done < <(env | awk -F= '/^VAST_TCP_PORT_[0-9]+=/ { print }' | sort || true)
}

serve_urls() {
  local host="${FI_UI_HOST:-0.0.0.0}"
  ok "UI inside this machine: http://127.0.0.1:$UI_PORT"
  info "engine: 127.0.0.1:$SD_PORT"

  # Vast.ai: 172.17.x is the container IP and is not reachable from a browser.
  # Each open internal port is mapped to a random public port (VAST_TCP_PORT_<internal>).
  if [ -n "${PUBLIC_IPADDR:-}${VAST_CONTAINERLABEL:-}" ]; then
    # ${!name:-} is not valid indirect expansion under set -u ("invalid indirect expansion").
    local ext
    ext="$(printenv "VAST_TCP_PORT_${UI_PORT}" 2>/dev/null || true)"
    if [ -n "${PUBLIC_IPADDR:-}" ] && [ -n "$ext" ]; then
      ok "open in your browser: http://${PUBLIC_IPADDR}:$ext"
      info "that public port maps to internal $UI_PORT (Vast.ai)"
      return
    fi
    info "Vast.ai did not publish internal port $UI_PORT."
    info "172.x addresses are inside Docker and will not load in your browser."
    info "On the instance page: Edit → Docker create options, add:"
    info "  -p ${UI_PORT}:${UI_PORT} -e OPEN_BUTTON_PORT=${UI_PORT}"
    info "Recreate the instance (port maps are fixed at start), then run ./fi serve again."
    if [ -n "${PUBLIC_IPADDR:-}" ] && [ -n "${VAST_TCP_PORT_22:-}" ]; then
      info "or SSH tunnel without opening $UI_PORT:"
      info "  ssh -p ${VAST_TCP_PORT_22} root@${PUBLIC_IPADDR} -L ${UI_PORT}:127.0.0.1:${UI_PORT}"
      info "  then open http://127.0.0.1:${UI_PORT}"
    fi
    local mapped="" line in_port out_port
    while IFS= read -r line; do
      in_port="${line#VAST_TCP_PORT_}"; in_port="${in_port%%=*}"
      out_port="${line#*=}"
      mapped="${mapped:+$mapped, }${in_port}→${out_port}"
    done < <(env | grep -E '^VAST_TCP_PORT_[0-9]+=' | sort || true)
    [ -n "$mapped" ] && info "ports already published (internal→public): $mapped"
    return
  fi

  if [ "$host" = "0.0.0.0" ] || [ "$host" = "::" ]; then
    local ip
    for ip in $(hostname -I 2>/dev/null || true); do
      case "$ip" in 127.*|::1|fe80:*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) continue ;; esac
      ok "from network: http://$ip:$UI_PORT"
    done
  fi
}

cmd_serve() {
  printf 'starting freeimage…\n'
  require_install
  start_engine
  ok "engine ready ($FI_DEVICE)"
  if [ "$FI_PLATFORM" = cuda ]; then
    # First request pays lazy CUDA kernel loading + graph capture; pay it before the user does.
    # Synchronous so it never overlaps a UI request (that bypasses serve.py's GPU lock).
    info "warming up CUDA kernels…"
    post_txt2img "warm up" 1024 1024 1 >/dev/null 2>&1 || true
  fi
  vast_bind_ui_port
  serve_urls
  # UI unlocks 2048² when VRAM / unified memory is 24 GB+.
  local mem_gb=0
  if [ "${FI_UNIFIED_GB:-0}" -gt 0 ]; then mem_gb=$FI_UNIFIED_GB
  else mem_gb=$(( FI_VRAM_MB / 1024 )); fi
  # Default 0.0.0.0 so headless / cloud port proxies can reach :7861.
  # Restrict with FI_UI_HOST=127.0.0.1 if you only want loopback.
  FI_SD_URL="http://127.0.0.1:$SD_PORT" FI_OUT="$ROOT/outputs" FI_STEPS="$FI_STEPS" \
    FI_MEM_GB="$mem_gb" \
    python3 "$ROOT/ui/serve.py" --host "${FI_UI_HOST:-0.0.0.0}" --port "$UI_PORT" &
  UI_PID=$!
  # sd-server can die mid-session (CUDA error, OOM kill). Show why and bring it back.
  while kill -0 "$UI_PID" 2>/dev/null; do
    if [ -n "${SD_PID:-}" ] && ! kill -0 "$SD_PID" 2>/dev/null; then
      cp "$FI_HOME/server.log" "$FI_HOME/server.crash.log"
      printf '\n%s✗ engine stopped — last log lines (full: %s)%s\n' "$R" "$FI_HOME/server.crash.log" "$N" >&2
      # ggml aborts by attaching gdb; the real error is just before gdb's "[New LWP" spam.
      awk '/^\[New LWP/ { exit } { print }' "$FI_HOME/server.crash.log" | tail -25 >&2
      dmesg 2>/dev/null | grep -iE 'killed process|out of memory|NVRM|Xid' | tail -5 >&2 || true
      info "restarting engine…"
      start_engine
      ok "engine restarted"
    fi
    sleep 2
  done
}

cmd_bench() {
  require_install
  start_engine
  local prompts=(
    "a red fox standing in fresh snow at golden hour, detailed fur"
    "a cozy ramen shop at night in the rain, neon reflections"
    "studio portrait of an elderly fisherman, soft window light"
  )
  step "Benchmark: 1024×1024, 8 steps ($FI_DEVICE)"
  info "warm-up…"
  post_txt2img "warm up" 512 512 4 >/dev/null
  local total=0 p t
  for p in "${prompts[@]}"; do
    t="$(post_txt2img "$p" 1024 1024 8)"
    printf '  %6.1f s  %s\n' "$t" "$p"
    total="$(awk -v a="$total" -v b="$t" 'BEGIN { print a + b }')"
  done
  ok "$(awk -v t="$total" -v n=${#prompts[@]} 'BEGIN { printf "%.1f s per image on average", t / n }')"
  info "last image breakdown (text encode / sampling / VAE decode):"
  grep -aoE '(get_learned_condition|sampling|decode_first_stage) completed, taking [0-9.]+s' "$FI_HOME/server.log" \
    | tail -3 | sed 's/^/    /' || true
}

# prompt width height steps → prints seconds
post_txt2img() {
  curl -sf -o /dev/null -w '%{time_total}' "http://127.0.0.1:$SD_PORT/sdapi/v1/txt2img" \
    -H 'content-type: application/json' \
    -d "{\"prompt\": \"$1\", \"width\": $2, \"height\": $3, \"steps\": $4, \"cfg_scale\": 1.0, \"seed\": 42}"
}

cmd_doctor() {
  engine_args
  echo "platform : $FI_PLATFORM"
  echo "device   : $FI_DEVICE"
  if [ "$FI_PLATFORM" = cuda ]; then
    echo "arch     : sm_$FI_CUDA_ARCH"
    if [ "${FI_UNIFIED_GB:-0}" -gt 0 ]; then
      echo "memory   : ${FI_UNIFIED_GB} GB unified (nvidia-smi VRAM N/A)"
    else
      echo "vram     : $(( FI_VRAM_MB / 1024 )) GB"
    fi
    if [ "${FI_CUDA_ARCH:-0}" -ge 80 ]; then
      echo "attn     : SageAttention (--sage-attn)"
    else
      echo "attn     : flash attention (Turing / pre-Ampere; SageAttention needs sm_80+)"
    fi
  fi
  [ "$FI_PLATFORM" = metal ] && [ "${FI_UNIFIED_GB:-0}" -gt 0 ] && echo "unified  : ${FI_UNIFIED_GB} GB"
  echo "home     : $FI_HOME"
  echo "engine   : $([ -x "$FI_HOME/bin/sd-cli" ] && echo built || echo 'not built (./install.sh)')"
  local llm; llm="$(select_llm "$FI_HOME/models")"
  echo "models   : $([ -f "$FI_HOME/models/z_image_turbo_int8_convrot.safetensors" ] && echo present || echo 'missing (./install.sh --models)')"
  echo "llm      : $(basename "$llm")$([ -f "$llm" ] || echo ' (missing — ./install.sh --models)')"
  echo "steps    : $FI_STEPS"
  echo "flags    : ${FI_ARGS[*]##*/}"
}

case "${1:-}" in
  ""|-h|--help|help) usage ;;
  serve) shift; cmd_serve "$@" ;;
  bench) shift; cmd_bench "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  *) cmd_generate "$@" ;;
esac
