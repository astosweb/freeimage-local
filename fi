#!/usr/bin/env bash
# fi — run Z-Image Turbo (int8) locally.
#
#   fi "a red fox in fresh snow"          make one image → outputs/
#   fi "..." --size 768x1344 --seed 7     portrait, fixed seed
#   fi serve                              web UI on :7861 (prints LAN URL / SSH tip)
#   fi bench                              measure seconds per image on this machine
#   fi doctor                             show what was detected and which flags are used
#
# Options for single images:
#   --size WxH     default 1024x1024 (multiples of 64)
#   --steps N      default 8, 6 on Macs with ≤18 GB (6 is faster with a little less detail)
#   --seed N       default random
#   -o FILE        output path (default outputs/<time>.png)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
# shellcheck source=scripts/common.sh
source "$ROOT/scripts/common.sh"

SD_PORT="${FI_SD_PORT:-7860}"
UI_PORT="${FI_UI_PORT:-7861}"

usage() { sed -n '2,15p' "$ROOT/fi" | sed 's/^# \{0,1\}//'; }

start_engine() {
  engine_args
  if curl -sf "http://127.0.0.1:$SD_PORT/sdapi/v1/sd-models" >/dev/null 2>&1; then return; fi
  info "loading the model (first start takes a moment)…"
  "$FI_HOME/bin/sd-server" --listen-ip 127.0.0.1 --listen-port "$SD_PORT" "${FI_ARGS[@]}" --steps "$FI_STEPS" \
    >"$FI_HOME/server.log" 2>&1 &
  SD_PID=$!
  trap 'kill $SD_PID 2>/dev/null || true' EXIT INT TERM
  local i=0
  until curl -sf "http://127.0.0.1:$SD_PORT/sdapi/v1/sd-models" >/dev/null 2>&1; do
    kill -0 "$SD_PID" 2>/dev/null || { tail -20 "$FI_HOME/server.log"; die "engine stopped. Log: $FI_HOME/server.log"; }
    i=$((i + 1)); [ "$i" -gt 600 ] && die "engine did not start in 5 minutes. Log: $FI_HOME/server.log"
    sleep 0.5
  done
}

cmd_generate() {
  local prompt="" size=1024x1024 steps="" seed=-1 out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) size="$2"; shift 2 ;;
      --steps) steps="$2"; shift 2 ;;
      --seed) seed="$2"; shift 2 ;;
      -o|--out) out="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) prompt="${prompt:+$prompt }$1"; shift ;;
    esac
  done
  [ -n "$prompt" ] || { usage; exit 1; }
  require_install
  engine_args
  steps="${steps:-$FI_STEPS}"
  local w="${size%x*}" h="${size#*x}"
  mkdir -p "$ROOT/outputs"
  out="${out:-$ROOT/outputs/$(date +%Y%m%d-%H%M%S).png}"
  info "$FI_DEVICE · ${w}×${h} · $steps steps"
  local t0=$SECONDS
  "$FI_HOME/bin/sd-cli" "${FI_ARGS[@]}" -p "$prompt" -W "$w" -H "$h" --steps "$steps" -s "$seed" -o "$out" \
    >"$FI_HOME/last.log" 2>&1 || { tail -20 "$FI_HOME/last.log"; die "generation failed. Log: $FI_HOME/last.log"; }
  ok "$out  ($((SECONDS - t0)) s incl. model load — use 'fi serve' to keep it loaded)"
}

# Print URLs that actually work from this machine / a remote browser.
serve_urls() {
  info "UI listening on 0.0.0.0:$UI_PORT (engine stays on 127.0.0.1:$SD_PORT)"
  ok "on this host:  http://127.0.0.1:$UI_PORT"
  local ip
  # Best-effort LAN/public addresses — helpful on headless Ubuntu servers.
  for ip in $(hostname -I 2>/dev/null || true); do
    case "$ip" in
      127.*|::1|fe80:*) continue ;;
    esac
    ok "from network:  http://$ip:$UI_PORT"
  done
  info "no browser on the server? from your laptop:  ssh -L $UI_PORT:127.0.0.1:$UI_PORT USER@HOST"
  info "then open http://127.0.0.1:$UI_PORT  (open firewall / cloud security group for $UI_PORT if using the network URL)"
}

cmd_serve() {
  require_install
  start_engine
  ok "engine ready ($FI_DEVICE)"
  serve_urls
  FI_SD_URL="http://127.0.0.1:$SD_PORT" FI_OUT="$ROOT/outputs" FI_STEPS="$FI_STEPS" \
    python3 "$ROOT/ui/serve.py" --host "${FI_UI_HOST:-0.0.0.0}" --port "$UI_PORT"
}

cmd_bench() {
  require_install
  start_engine
  local prompts=(
    "a red fox standing in fresh snow at golden hour, detailed fur"
    "a cozy ramen shop at night in the rain, neon reflections"
    "studio portrait of an elderly fisherman, soft window light"
  )
  step "Benchmark: 1024×1024, 8 steps ($FI_DEVICE)"
  info "warm-up…"
  post_txt2img "warm up" 512 512 4 >/dev/null
  local total=0 p t
  for p in "${prompts[@]}"; do
    t="$(post_txt2img "$p" 1024 1024 8)"
    printf '  %6.1f s  %s\n' "$t" "$p"
    total="$(awk -v a="$total" -v b="$t" 'BEGIN { print a + b }')"
  done
  ok "$(awk -v t="$total" -v n=${#prompts[@]} 'BEGIN { printf "%.1f s per image on average", t / n }')"
}

# prompt width height steps → prints seconds
post_txt2img() {
  curl -sf -o /dev/null -w '%{time_total}' "http://127.0.0.1:$SD_PORT/sdapi/v1/txt2img" \
    -H 'content-type: application/json' \
    -d "{\"prompt\": \"$1\", \"width\": $2, \"height\": $3, \"steps\": $4, \"cfg_scale\": 1.0, \"seed\": 42}"
}

cmd_doctor() {
  engine_args
  echo "platform : $FI_PLATFORM"
  echo "device   : $FI_DEVICE"
  if [ "$FI_PLATFORM" = cuda ]; then
    echo "arch     : sm_$FI_CUDA_ARCH"
    echo "vram     : $(( FI_VRAM_MB / 1024 )) GB"
    if [ "${FI_CUDA_ARCH:-0}" -ge 80 ]; then
      echo "attn     : SageAttention (--sage-attn)"
    else
      echo "attn     : flash attention (Turing / pre-Ampere; SageAttention needs sm_80+)"
    fi
  fi
  [ "$FI_PLATFORM" = metal ] && [ "${FI_UNIFIED_GB:-0}" -gt 0 ] && echo "unified  : ${FI_UNIFIED_GB} GB"
  echo "home     : $FI_HOME"
  echo "engine   : $([ -x "$FI_HOME/bin/sd-cli" ] && echo built || echo 'not built (./install.sh)')"
  local llm; llm="$(select_llm "$FI_HOME/models")"
  echo "models   : $([ -f "$FI_HOME/models/z_image_turbo_int8_convrot.safetensors" ] && echo present || echo 'missing (./install.sh --models)')"
  echo "llm      : $(basename "$llm")$([ -f "$llm" ] || echo ' (missing — ./install.sh --models)')"
  echo "steps    : $FI_STEPS"
  echo "flags    : ${FI_ARGS[*]##*/}"
}

case "${1:-}" in
  ""|-h|--help|help) usage ;;
  serve) shift; cmd_serve "$@" ;;
  bench) shift; cmd_bench "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  *) cmd_generate "$@" ;;
esac
